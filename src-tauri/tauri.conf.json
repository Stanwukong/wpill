{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cay",
  "version": "0.1.0",
  "identifier": "io.github.stanwukong.cay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Oluwafemi S.E. Ajanaku",
    "copyright": "Copyright (c) 2026 Oluwafemi S.E. Ajanaku. MIT License.",
    "license": "MIT",
    "shortDescription": "A Dynamic Island for Windows 11",
    "homepage": "https://github.com/Stanwukong/wpill"
  }
}
